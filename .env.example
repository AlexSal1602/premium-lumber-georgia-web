# Server-only. URL-encode the database password; do not retain placeholder brackets.
# Session pooler (5432) supports IPv4; direct db host requires IPv6 unless IPv4 add-on is enabled.
DATABASE_URL="postgresql://USER:ENCODED_PASSWORD@HOST:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://USER:ENCODED_PASSWORD@HOST:5432/postgres?sslmode=require"
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_PUBLISHABLE_KEY=""
# Server-only Resend key: Sending access, restricted to lumber.ge. Never NEXT_PUBLIC_.
RESEND_API_KEY=""
ORDER_EMAIL_FROM="Lumber.ge <orders@lumber.ge>"
# Server-only Google Cloud Translation Basic (v2) API key. Enable the API and billing.
GOOGLE_TRANSLATE_API_KEY=""
# Canonical production origin, including https://; recommended behind a reverse proxy.
# APP_ORIGIN="https://your-domain.example"
# Optional explicit PostgreSQL test connection; uses a random isolated schema. Dedicated test database recommended.
# TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/georgia_woods_test"
