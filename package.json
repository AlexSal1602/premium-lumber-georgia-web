{
  "name": "premium-lumber-georgia",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/catalog.test.cjs tests/checkout.test.cjs tests/admin.test.cjs tests/locales.test.cjs tests/inventory.test.cjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:setup": "node scripts/setup-db.cjs",
    "postinstall": "prisma generate",
    "db:seed": "node scripts/seed.cjs",
    "db:storage": "prisma db execute --file prisma/supabase-storage.sql --schema prisma/schema.prisma",
    "admin:grant": "node scripts/grant-admin.cjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@prisma/client": "^6.19.2",
    "dotenv": "^16.6.1",
    "lucide-react": "^0.468.0",
    "next": "^15.5.12",
    "prisma": "^6.19.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.88.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.23"
    },
    "@prisma/config": {
      "deepmerge-ts": "^8.0.0",
      "effect": "^3.20.0"
    }
  }
}
