generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Order {
  id             Int         @id @default(autoincrement())
  idempotencyKey String      @unique
  requestHash    String
  status         OrderStatus @default(NEW)
  notes          String      @default("")
  updatedAt      DateTime    @updatedAt
  locale         String
  fullName       String
  phone          String
  email          String?
  city           String?
  address        String?
  deliveryMethod String
  comment        String?
  currency       String      @default("GEL")
  totalCents     Int
  createdAt      DateTime    @default(now())
  items          OrderItem[]
  inventoryDeductedAt DateTime?
  inventoryReturnedAt DateTime?
  movements InventoryMovement[]
  notification OrderNotification?

  @@index([status, createdAt])
}

model OrderItem {
  id             Int    @id @default(autoincrement())
  orderId        Int
  order          Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String
  variantId      String
  nameKa         String
  nameEn         String
  nameRu         String
  thickness      Float
  width          Float
  length         Float
  coverageWidth  Float?
  species        String
  grade          String
  moisture       String
  availability   String
  unit           String
  quantityMilli  Int
  basePriceCents Int
  basePriceUnit  String
  unitPrice      Float
  totalCents     Int

  @@index([orderId])
}


enum OrderStatus {
  NEW
  PROCESSING
  SHIPPED
  COMPLETED
  CANCELLED
}

model OrderNotification {
  orderId Int @id
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status String @default("PENDING")
  attempts Int @default(0)
  firstAttemptAt DateTime?
  lastAttemptAt DateTime?
  leaseUntil DateTime?
  leaseToken String?
  payload Json?
  providerId String? @unique
  acceptedAt DateTime?
  lastError String?
  @@index([status, leaseUntil])
}

model AdminUser {
  id        String   @id @db.Uuid
  email     String   @unique
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  movements InventoryMovement[]
}

model Category {
  id        String    @id
  name      Json
  products  Product[]
  createdAt DateTime  @default(now())
}

model Product {
  id               String           @id
  categoryId       String
  category         Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  name             Json
  shortDescription Json
  description      Json
  images           Json
  species          String
  grade            String
  moisture         String
  units            String[]
  active           Boolean          @default(true)
  variants         ProductVariant[]
  movements        InventoryMovement[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  @@index([categoryId, active])
}

model ProductVariant {
  id             String  @id
  productId      String
  product        Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  thickness      Float
  width          Float
  length         Float
  coverageWidth  Float?
  priceCents     Int
  priceUnit      String
  status         String
  position       Int     @default(0)
  stockQuantity Decimal @default(0) @db.Decimal(18, 3)
  stockUnit String @default("piece")
  lowStockThreshold Decimal @default(0) @db.Decimal(18, 3)
  trackInventory Boolean @default(false)
  updatedAt DateTime @default(now()) @updatedAt
  inventoryVersion Int @default(0)
  movements InventoryMovement[]
  @@index([productId, position])
}

enum InventoryMovementType {
  SALE
  RECEIPT
  RETURN
  ADJUSTMENT
  DAMAGE
  INITIAL
}

model InventoryMovement {
  id String @id @default(cuid())
  productId String
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId String
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  type InventoryMovementType
  quantity Decimal @db.Decimal(18, 3)
  beforeQuantity Decimal @db.Decimal(18, 3)
  afterQuantity Decimal @db.Decimal(18, 3)
  stockUnit String
  reason String
  note String @default("")
  adminId String? @db.Uuid
  admin AdminUser? @relation(fields: [adminId], references: [id], onDelete: Restrict)
  orderId Int?
  order Order? @relation(fields: [orderId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  @@index([variantId, createdAt])
  @@index([orderId, type])
}

model Post {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     Json
  excerpt   Json
  body      Json
  image     String?
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([published, createdAt])
}
